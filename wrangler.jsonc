{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecc-worker-app",
  "main": "src-worker/index.ts",
  "compatibility_date": "2026-04-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_NAME": "ECC"
  }
}
