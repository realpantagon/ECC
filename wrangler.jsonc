{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ats-ecc-2026",
  "main": "src-worker/index.ts",
  "compatibility_date": "2026-04-07",
  "triggers": {
    "crons": ["*/4 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_NAME": "ECC",
    "FRONTEND_ORIGIN": "http://localhost:5173,http://localhost:5176,https://*.pages.dev"
  }
}
